{
  "AWS": {
    "Region": "eu-west-2",
    "EMF": {
      "Namespace": "cads-bridge",
      "ServiceName": "CadsBridge"
    },
    "Metrics": {
      "MeterName": "CadsBridge"
    }
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "DataSeedingImportEnabled": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  },
  "Storage": {
    "External": {
      "BucketName": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
      "HealthcheckEnabled": true,
      "AccessKeySecretName": "IMB_S3_ACCESS_KEY",
      "SecretKeySecretName": "IMB_S3_ACCESS_SECRET"
    },
    "Internal": {
      "BucketName": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
      "HealthcheckEnabled": true
    }
  },
  "ApiClients": {
    "CdsApi": {
      "BaseUrl": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
      "BasicApiKey": "Set in CDP secrets (or for local development using docker-compose.override.yml)",
      "XApiKey": null,
      "HealthcheckEnabled": true,
      "UseFakeClient": false,
      "ResiliencePolicy": {
        "Retries": 3,
        "BaseDelaySeconds": 2,
        "UseJitter": true,
        "TimeoutPeriodSeconds": 30
      }
    }
  },
  "Messaging": {
    "Queues": {
      "CadsBridgeFifo": {
        "Name": "CadsBridgeFifoQueueClient",
        "QueueUrl": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
        "DlqQueueUrl": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
        "MaxNumberOfMessages": 10,
        "WaitTimeSeconds": 5,
        "HealthcheckEnabled": true
      }
    }
  },
  "DataLoad": {
    "Salt": "Set in cdp-app-config (or for local development using docker-compose.override.yml)",
    "SplitType": "ByLines",
    "SplitValue": 100000,
    "MaxRetryAttempts": 3,
    "RetryDelayBase": 500,
    "MaxParallelDownloads": 4
  },
  "DistributedLock": {
    "KeyPrefix": "locks",
    "LeaseDuration": "00:05:00",
    "MaxAcquireAttempts": 3
  },
  "Quartz": {
    "Jobs": [
      {
        "JobType": "BulkScanJob",
        "Enabled": true,
        "CronSchedule": "0 * * * * ?",
        "EnabledFrom": "2026-07-01T10:00:00",
        "EnabledTo": "2099-01-01T00:00:00"
      },
      {
        "JobType": "DeltaScanJob",
        "Enabled": false,
        "CronSchedule": "0 * * * * ?",
        "EnabledFrom": "2026-07-01T10:00:00",
        "EnabledTo": "2099-01-01T00:00:00"
      }
    ]
  }
}
