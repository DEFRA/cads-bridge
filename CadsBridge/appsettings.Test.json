{
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "EnableAdminEndpoints": true,
  "EnableDataSeedingImportEndpoints": true,
  "EnableTestSupportEndpoints": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AuthenticationConfiguration": {
    "ApiKey": {
      "Enabled": true
    },
    "AwsSts": {
      "Enabled": false,
      "Audience": "https://cads-bridge.test",
      "TrustedOrgId": "o-test",
      "Environment": "Test"
    },
    "AzureAD": {
      "Enabled": true,
      "Authority": "http://localhost:5557",
      "Audience": "api://local-cads-cds",
      "MetadataAddress": "http://localhost:5557/.well-known/openid-configuration",
      "RequireHttpsMetadata": false,
      "ValidateIssuer": false,
      "ScopeClaimType": "scope",
      "RoleClaimType": "role"
    }
  },
  "Acl": {
    "Clients": {
      "TestClient": {
        "Type": "ApiKey",
        "Secret": "test-secret",
        "Scopes": [ "access", "admin.s3.manager", "admin.queue.manager" ]
      }
    },
    "StsClients": {
      "cads-data-service": {
        "Scopes": [ "access", "admin.s3.manager", "admin.queue.manager" ]
      }
    }
  },
  "Encryption": {
    "CurrentKeyId": "V1",
    "StorageEncryptionEnabled": true,
    "Keys": {
      "V1": "Set in ApiContainerFixture and WebAppFactoryBase)"
    }
  }
}
